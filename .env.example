# RecallOps — Environment Variables Template
# When external keys are absent, RecallOps runs seamlessly in "Demo Mode" with local in-memory storage.

# Groq LLM API Configuration
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Hindsight Cloud Memory Configuration
HINDSIGHT_API_KEY=
HINDSIGHT_API_BASE_URL=https://api.hindsight.cloud
HINDSIGHT_INCIDENTS_BANK_ID=bank_incidents_prod_01
HINDSIGHT_FIX_OUTCOMES_BANK_ID=bank_fix_outcomes_prod_01
HINDSIGHT_TEAM_BANK_ID=bank_team_prod_01
HINDSIGHT_BASELINE_BANK_ID=bank_baseline_prod_01

# Web Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
